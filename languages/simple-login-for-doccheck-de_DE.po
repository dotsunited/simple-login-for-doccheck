#. Plugin Name of the plugin
#: simple-login-for-doccheck.php
#: admin/class-simple-login-for-doccheck-admin.php:79
#: admin/class-simple-login-for-doccheck-admin.php:80
msgid "Simple Login for DocCheck"
msgstr "Simple Login for DocCheck"

#. Plugin URI of the plugin
#: simple-login-for-doccheck.php
msgid "https://github.com/dotsunited/simple-login-for-doccheck"
msgstr ""

#. Description of the plugin
#: simple-login-for-doccheck.php
msgid "Protects selected pages with a DocCheck OAuth 2.0 login for verified medical professionals."
msgstr "Schützt ausgewählte Seiten mit einem DocCheck-Login über OAuth 2.0 für verifizierte medizinische Fachkräfte."

#. Author of the plugin
#: simple-login-for-doccheck.php
msgid "Dots United GmbH"
msgstr ""

#. Author URI of the plugin
#: simple-login-for-doccheck.php
msgid "https://dotsunited.de/"
msgstr ""

